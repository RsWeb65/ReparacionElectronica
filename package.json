{
  "name": "reparaciones-monorepo",
  "private": true,
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @reparaciones/api\" \"npm run dev -w @reparaciones/web\"",
    "dev:api": "npm run dev -w @reparaciones/api",
    "dev:web": "npm run dev -w @reparaciones/web"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}